# ==============================================================================
# NEXTLEAD CRM & WHATSAPP AI - PLANTILLA DE VARIABLES DE ENTORNO
# ==============================================================================
# Duplica este archivo con el nombre '.env' en la raíz y coloca tus credenciales:

# ------------------------------------------------------------------------------
# 1. META WHATSAPP CLOUD API
# ------------------------------------------------------------------------------
WHATSAPP_API_TOKEN=tu_token_permanente_de_meta_aqui
WHATSAPP_PHONE_ID=tu_phone_number_id_aqui
WHATSAPP_VERIFY_TOKEN=nextlead_verify_token
WHATSAPP_DISPLAY_NUMBER=+15551935901
WHATSAPP_API_VERSION=v18.0

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI CONFIGURATION
# ------------------------------------------------------------------------------
GEMINI_API_KEY=tu_api_key_de_google_gemini_aqui
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 3. BASE DE DATOS POSTGRESQL (DOCKER)
# ------------------------------------------------------------------------------
POSTGRES_DB=nextlead
POSTGRES_USER=postgres
POSTGRES_PASSWORD=nextlead_password
# POSTGRES_PORT=5433 # Opcional: solo si se requiere mapear al host fuera de Docker
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/nextlead

# ------------------------------------------------------------------------------
# 4. SEGURIDAD Y JWT (JSON WEB TOKENS)
# ------------------------------------------------------------------------------
JWT_SECRET=tu_clave_secreta_jwt_de_al_menos_256_bits_aqui
JWT_EXPIRATION=86400000

# ------------------------------------------------------------------------------
# 5. FRONTEND (NEXT.JS) Y PUERTOS
# ------------------------------------------------------------------------------
FRONTEND_PORT=3080
BACKEND_PORT=8081
NEXT_PUBLIC_API_URL=http://localhost:8081

# ------------------------------------------------------------------------------
# 6. CONFIGURACIÓN DEL SISTEMA Y ZONA HORARIA
# ------------------------------------------------------------------------------
TZ=America/Lima
